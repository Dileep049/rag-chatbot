# LLM Provider Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Local Embeddings Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional OpenAI Configuration
OPENAI_API_KEY=

# Paths & Directories
CHROMA_PERSIST_DIR=backend/chroma_db
DATA_DIR=backend/data

# Authentication & Admin Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

ADMIN_EMAIL=chintaladileep968@gmail.com 
ADMIN_PASSWORD=9381887173@0000

# Production RAG Settings
RAG_TOP_K=15
RAG_FINAL_K=4
RAG_RELEVANCE_THRESHOLD=0.20
RAG_DEBUG=false

# Security, CORS & Rate Limiting
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT=60
UPLOAD_RATE_LIMIT=15
MAX_UPLOAD_SIZE_MB=30

# Frontend Production Configuration
VITE_API_URL=http://localhost:8000
